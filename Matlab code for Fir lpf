clc;
close all;
clear all;

fp=200;  % pass band frequency in hz ;
f=1000;  % sampling frequency in hz ;
wp=2*fp/f; % normalization of the passband frequency;
pkg load signal
N=20;
%b_rect=fir1(N-1,wp,'low',boxcar(N)); % calculation of fir rectangular low pass co-efficients;
b_ham=fir1(N-1,wp,'low',hamming(N)); % calculation of fir Hamming low pass co-efficients;
%b_han=fir1(N-1,wp,'low',hanning(N)); % calculation of fir Hanning low pass co-efficients;
%b_bart=fir1(N-1,wp,'low',bartlett(N)); % calculation of fir Triangular low pass co-efficients;
%b_kaiser=fir1(N-1,wp,'low',kaiser(N,57.9)); % calculation of fir Kaiser low pass co-efficients;

[h,w]=freqz(b_ham,1,512);  % transfer function of the low pass filter;
ha=tf(b_ham,1,512)
m=20*log10(abs(h));
figure
subplot(2,1,1);
plot(m)
xlabel('Normalised frequency');
ylabel('Gain in db');
title('Response of FIR low pass filter');
an=angle(h);
subplot(2,1,2);
plot(an);
xlabel('normalised frequency');
ylabel('phase angle');

f=1000;
t1 = 0:1/f:0.1;
f1 = f*(1:512)/512;

x = sin(2*pi*50*t1)+sin(2*pi*240*t1)+sin(2*pi*450*t1);

y=filter(b_ham,1,x);
X=fft(x,512);
Y=fft(y,512);

figure, subplot(211)
plot(f1,abs(X))
axis([0 512 0 60]);
title('Input signal to the filter')

subplot(212)
plot(f1,abs(Y))
axis([0 512 0 60]);
title('Filtered output')



